# Base path the site is served under. Must start and end with a slash.
BASE_PATH=/metro/

# Vector map styles (MapLibre style JSON URLs). Defaults: OpenFreeMap liberty and positron.
VITE_STYLE_STREETS=
VITE_STYLE_LIGHT=

# Satellite raster tiles ({z}/{y}/{x} or {z}/{x}/{y} template) and their attribution.
# Default: Esri World Imagery. Check the provider's terms for your use.
VITE_SATELLITE_TILES=
VITE_SATELLITE_ATTRIBUTION=
